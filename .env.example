# Copy to .env and adjust. Every value shown is the default.

# Listen address
BIND_ADDR=0.0.0.0:8080
# Where campaigns are loaded from: file (until Postgres support lands) or postgres
CAMPAIGN_SOURCE=file
# Used when CAMPAIGN_SOURCE=file; written by `make seed`
SEED_FILE=data/seed.json
# Postgres connection
DATABASE_URL=postgres://admatch:admatch@localhost:5432/admatch
# Redis connection (shared budgets)
REDIS_URL=redis://localhost:6379
# Budget backend: memory or redis
BUDGET_STORE=memory
# Admin API token (header X-Admin-Token)
ADMIN_TOKEN=dev-admin-token
# Age targeting requires an audience strictly greater than this
K_TARGETING=5000
# Minimum distinct users per report row
K_REPORTING=100
# Reserve price per tap, in micros
RESERVE_CPT_MICROS=100000
# Second-price increment, in micros
PRICE_INCREMENT_MICROS=10000
# Periodic index rebuild interval, in seconds (the campaign source is
# re-read and the index rebuilt; a failed reload keeps the old index)
INDEX_REFRESH_SECS=30
# Max impressions kept for tap lookup
IMPRESSION_CACHE_MAX=1000000
# How long an impression can still receive a tap, in seconds
IMPRESSION_TTL_SECS=600
# Bounded event channel size
EVENT_QUEUE_CAPACITY=100000
# Max rows per insert
EVENT_BATCH_SIZE=1000
# Max wait before a flush, in milliseconds
EVENT_FLUSH_MS=100
# Run embedded migrations on startup
RUN_MIGRATIONS=true
# Log filter
RUST_LOG=info
